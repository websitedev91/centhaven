# CentHaven on Hostinger (LiteSpeed/Apache). Copied into out/ by `next build` (public/ → out/).
# Static export with trailingSlash: false, so /about is served from about.html.
# Kept to widely supported directives only; check the site with the steps in docs/DEPLOY.md after changes.

Options -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One canonical origin: https://centhaven.com (forces HTTPS, drops www).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://centhaven.com%{REQUEST_URI} [R=301,L,NE]

  # 2. /index.html → /
  RewriteRule ^index\.html$ / [R=301,L]

  # 3. Clean URLs: /about and /about/ → about.html; /freelance → freelance.html even though a
  #    freelance/ folder also exists. Internal rewrite, no redirect, so no slash loops; every page's
  #    canonical tag names the no-slash URL.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Types the export uses (RSC payloads are .txt; share images are .png).
AddType text/plain .txt
AddType image/svg+xml .svg
AddType font/woff2 .woff2

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Pages and RSC data: always revalidate, so a new deploy shows up at once.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # JS, CSS and fonts only come from /_next/static and have content hashes in their names.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Share images and the favicon change rarely.
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>
